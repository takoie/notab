{
  "name": "notab",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n convex,app -c blue,magenta \"npx convex dev\" \"npm run tauri dev\"",
    "dev:vite": "vite",
    "dev:web": "concurrently -k -n convex,vite -c blue,green \"npx convex dev\" \"npm run dev:vite\"",
    "dev:desktop": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@lucide/svelte": "^1.41.0",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-opener": "^2.2.6",
    "@tauri-apps/plugin-process": "^2.2.1",
    "@tauri-apps/plugin-store": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.23.0",
    "fractional-indexing": "^3.2.0",
    "idb": "^8.0.2",
    "mathlive": "^0.110.0",
    "svelte-dnd-action": "^0.9.61",
    "tailwind-merge": "^3.0.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tauri-apps/cli": "^2.5.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.7",
    "@types/node": "^22.20.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "convex-test": "^0.0.37",
    "fake-indexeddb": "^6.0.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.3",
    "svelte": "^5.20.2",
    "svelte-check": "^4.1.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.1",
    "vitest": "^3.0.6"
  }
}
