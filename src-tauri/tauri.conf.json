{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NotaB!",
  "version": "0.3.0",
  "identifier": "no.taknes.notab",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev:vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NotaB!",
        "width": 720,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: tauri: http://ipc.localhost http://tauri.localhost; connect-src 'self' ipc: tauri: http://ipc.localhost http://tauri.localhost https://*.convex.cloud wss://*.convex.cloud https://*.convex.site wss://*.convex.site; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/takoie/notab/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCQjUxQzA2MkI1OUYyNjYKUldSbThsa3JCaHkxdTQ5MmZIbkZaeEs5RWF6VHlIbnVScUptMW1yOThyYzl0OW05U0pLRXNwQ1YK"
    }
  }
}
